    <script>
        jQuery(function ($) {
            function toggleSelectedContentTypes() {
                var value = $('#social-share-display-scope').val();

                if (value === 'selected_content_types') {
                    $('#selected-content-types-field').show();
                } else {
                    $('#selected-content-types-field').hide();
                }
            }

            $(document).on(
                'change select2:select',
                '#social-share-display-scope',
                toggleSelectedContentTypes
            );

            toggleSelectedContentTypes();
        });
